{
  "name": "sysvisionz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js dev",
    "build": "rm -rf .next && npm run build-server && next build",
    "export": "rm -rf ../export && mkdir ../export && mkdir ../export/.next && cp -r ./.next ../export && cp ./package.json ../export && cp ./server.js ../export && cp ./.env-prod ../export/.env && cp ./.npmrc-prod ../export/.npmrc && cp ./package-lock.json ../export/package-lock.json",
    "start": "node server.js",
    "test": "node server.js test",
    "lint": "next lint",
    "build-server": "tsc -p ./server-ts/tsconfig.json && cp -r ./server-ts/build/* ./ && rm -rf ./server-ts/build",
    "docker": "./.docker.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "http2-express-bridge": "^1.0.7",
    "iron-session": "^8.0.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "supercookie": "^5.0.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20.17.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/spdy": "^3.4.9",
    "@types/validator": "^13.12.2",
    "eslint": "^8",
    "eslint-config-next": "15.0.2",
    "sass": "^1.80.6",
    "typescript": "^5"
  },
  "allowScripts": {
    "supercookie@5.0.3": true
  }
}
