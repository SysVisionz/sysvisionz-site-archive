{
  "name": "sysvisionz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js dev",
    "build": "rm -rf .next && npm run build-server && next build && npm run build-export",
    "build-export": "rm -rf ../export && mkdir ../export && mkdir ../export/.next && cp -r ./.next ../export && cp ./package.json ../export && cp ./package-lock.json ../export && cp ./server.js ../export && cp ./.env-prod ../export/.env && cp ./.npmrc-prod ../export/.npmrc",
    "copy-certs": "if [ -d 'certs' ]; then rm -R certs; fi && mkdir certs && cp -r /etc/letsencrypt/live/sysvisionz.com/* certs/",
    "docker-build": "sudo docker build --output=$DOCKER_EXPORT -t sysvisionz --add-host host.docker.internal:host-gateway --no-cache --progress=plain  .",
    "docker-run": "sudo docker run sysvisionz",
    "deploy": "npm run copy-certs && npm run docker-build && npm run docker-run",
    "start": "node server.js",
    "test": "node server.js test",
    "lint": "next lint",
    "build-server": "tsc -p ./server-ts/tsconfig.json && cp -r ./server-ts/build/* ./ && rm -rf ./server-ts/build",
    "docker": "./.docker.sh"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "i": "^0.3.7",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "next": "^15.1.5",
    "next-logger": "^5.0.2",
    "npm": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spdy": "^4.0.2",
    "supercookie": "^5.0.3",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20.17.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/spdy": "^3.4.9",
    "@types/validator": "^13.12.2",
    "eslint": "^8",
    "eslint-config-next": "15.0.2",
    "sass": "^1.80.6",
    "typescript": "^5"
  }
}
